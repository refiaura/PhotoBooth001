{
  "name": "rindu-berat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/server/database.types.ts && prettier --write src/server/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jose": "^6.2.12",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  }
}
