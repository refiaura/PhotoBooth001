# Salin ke .env.local lalu isi. JANGAN commit file berisi nilai asli.
# Untuk pengembangan lokal, nilai Supabase didapat dari `pnpm exec supabase status`.

# --- Supabase ---------------------------------------------------------------
# URL proyek (lokal: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Kunci anon/publik. Aman di browser karena semua tabel tertutup RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci service role. RAHASIA, hanya di server (melewati RLS).
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret proyek (Dashboard > Project Settings > JWT). Dipakai server untuk
# menandatangani token pendek kanal Realtime privat. Minimal 32 karakter.
SUPABASE_JWT_SECRET=

# --- Akses ------------------------------------------------------------------
# Kode akses pribadi untuk membuat booth. Minimal 8 karakter.
ACCESS_CODE=

# --- TURN (Cloudflare Realtime TURN) -----------------------------------------
# Opsional saat lokal (tanpa ini hanya STUN). Wajib di production agar jaringan
# seluler (CGNAT) tetap tersambung. Isi berdua atau kosongkan berdua.
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# --- Cron -------------------------------------------------------------------
# Secret acak (minimal 16 karakter). Vercel mengirimnya sebagai Bearer token ke /api/cron/*.
CRON_SECRET=
